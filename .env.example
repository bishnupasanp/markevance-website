# Optional public form address. The owner's approved endpoint is the default.
# Rebuild after changing it. This is public; never add passwords or private keys.
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mvkzleqv

# Client portal. Both values are public browser settings. Configure after applying
# portal/schema.sql. Use a publishable key, never a secret or service-role key.
PUBLIC_PORTAL_SUPABASE_URL=
PUBLIC_PORTAL_SUPABASE_PUBLISHABLE_KEY=
