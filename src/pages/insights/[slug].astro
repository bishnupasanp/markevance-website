---
import { render, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPublishedInsights } from '../../lib/content.ts';
import type { BreadcrumbItem } from '../../types/site.ts';

export async function getStaticPaths() {
  const insights = await getPublishedInsights();
  return insights.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'insights'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/insights/' },
  { label: entry.data.title },
];
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`/insights/${entry.data.slug}/`}
  canonicalURL={entry.data.canonicalURL}
  breadcrumbs={breadcrumbs}
  noindex={entry.data.draft}
>
  <article class="content-article">
    <header class="article-header">
      <p class="article-meta">
        <span class="category">{entry.data.category}</span>
        <time datetime={entry.data.publishedAt}>{entry.data.publishedAt}</time>
      </p>
      <p class="article-lead">{entry.data.description}</p>
    </header>
    <div class="article-body prose">
      <Content />
    </div>
  </article>
</PageLayout>
