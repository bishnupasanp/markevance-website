---
import PageLayout from '../layouts/PageLayout.astro';
import LinkButton from '../components/ui/LinkButton.astro';
---

<PageLayout
  title="Page not found"
  description="The requested page could not be found. Return to the Markevance homepage or explore our solutions."
  path="/404/"
  noindex={true}
  eyebrow="404 / PAGE NOT FOUND"
  intro="The address may have changed, or the page may not exist. These routes can help you continue."
>
  <h2>Find your next step.</h2>
  <div class="foundation-links">
    <LinkButton href="/">Return home</LinkButton>
    <LinkButton href="/services/" variant="secondary">
      Explore solutions
    </LinkButton>
    <LinkButton href="/contact/" variant="secondary">
      Contact
    </LinkButton>
  </div>
</PageLayout>
