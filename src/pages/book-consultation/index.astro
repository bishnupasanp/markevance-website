---
import PageLayout from '../../layouts/PageLayout.astro';
import ConsultationForm from '../../components/forms/ConsultationForm.astro';
import LinkButton from '../../components/ui/LinkButton.astro';
import { getRoute } from '../../data/routes.ts';
import type { BreadcrumbItem } from '../../types/site.ts';

const route = getRoute('/book-consultation/');
const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: route.title },
];
---

<PageLayout
  title={route.title}
  heading="A clearer direction starts with a conversation."
  eyebrow="GROWTH CONSULTATION"
  intro="Tell us what you sell, who you want to reach and where growth gets difficult. We’ll use that context to discuss the next useful step for your business."
  description="Request a Markevance growth consultation. Share your business context, customer-acquisition challenge and objective for the next 3–6 months."
  path={route.path}
  breadcrumbs={breadcrumbs}
  noindex={!route.indexable}
>
  <div slot="hero" class="foundation-links">
    <LinkButton href="#consultation-form">
      Tell us about your business
    </LinkButton>
    <a
      class="text-link consultation-whatsapp"
      href="https://wa.me/9779815515225"
      target="_blank"
      rel="noreferrer"
    >
      Message on WhatsApp
    </a>
  </div>
  <div class="consultation-page">
    <div class="consultation-form-wrapper">
      <ConsultationForm />
    </div>
    <aside
      class="consultation-content"
      aria-labelledby="consultation-next-title"
    >
      <p class="eyebrow">BEFORE WE TALK</p>
      <h2 id="consultation-next-title">Start with the bottleneck.</h2>
      <p>
        Identify the bottleneck before choosing a marketing channel or service.
        This is intended for established businesses with a working offer,
        existing customers and capacity to handle more demand.
      </p>
      <ol class="consultation-next">
        <li>
          <h3>Share your context</h3>
          <p>
            Your offer, audience and growth objective give us a useful starting
            point.
          </p>
        </li>
        <li>
          <h3>Find the constraint</h3>
          <p>
            Discuss where demand, lead quality or sales follow-through needs
            attention.
          </p>
        </li>
        <li>
          <h3>Agree a next step</h3>
          <p>
            If there’s a fit, discuss a meeting and the right scope. Nothing is
            booked automatically.
          </p>
        </li>
      </ol>
      <p>
        A consultation is a starting conversation, not a promise of results or
        an agreed engagement. Scope, responsibilities and fees require a
        separate discussion.
      </p>
      <div class="foundation-links">
        <LinkButton href="/services/" variant="secondary">
          Explore solutions
        </LinkButton>
        <a class="text-link" href="/contact/">
          Other ways to reach us
        </a>
      </div>
    </aside>
  </div>
</PageLayout>
<style>
  .consultation-page {
    align-items: start;
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  .consultation-content {
    border-top: 2px solid var(--color-text-dark);
    padding-top: 1.5rem;
  }
  .consultation-content > .eyebrow {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  .consultation-content > p {
    color: var(--color-text-secondary);
  }
  .consultation-content h2 {
    max-width: 14ch;
  }
  .consultation-next {
    list-style: none;
    padding: 0;
    counter-reset: consultation-step;
  }
  .consultation-next li {
    border-top: 1px solid var(--border-light);
    padding-block: 1.25rem;
    counter-increment: consultation-step;
  }
  .consultation-next h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0;
    margin-bottom: 0.5rem;
  }
  .consultation-next h3::before {
    content: '0' counter(consultation-step) ' / ';
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }
  .consultation-next p {
    font-size: 1rem;
    color: var(--color-text-secondary);
  }
  .consultation-next li + li {
    margin-top: 0;
  }
  @media (min-width: 64rem) {
    .consultation-page {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 63.999rem) {
    .consultation-page {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .consultation-whatsapp {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
</style>
