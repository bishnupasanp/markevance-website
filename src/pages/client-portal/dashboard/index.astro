---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import BrandArtwork from '../../../components/ui/BrandArtwork.astro';
import ThemeToggle from '../../../components/ui/ThemeToggle.astro';
const sections = [
  ['overview', 'Overview', '◫'],
  ['performance', 'Website performance', '↗'],
  ['work', 'Work & progress', '✓'],
  ['reports', 'Reports', '▤'],
  ['workspace', 'Workspace', '⊞'],
];
---

<PortalLayout title="Client workspace" path="/client-portal/dashboard/">
  <div class="portal-app" data-portal-app>
    <aside class="portal-sidebar">
      <a
        href="/"
        aria-label="Markevance Growth Marketing & Sales Development home"
        class="portal-brand"
      >
        <BrandArtwork />
      </a>
      <div class="portal-company">
        <span class="company-initial" data-company-initial>
          —
        </span>
        <span>
          <strong data-company-name>Client workspace</strong>
          <small data-company-domain>Loading account</small>
        </span>
      </div>
      <p class="portal-nav-label">YOUR WORKSPACE</p>
      <nav aria-label="Workspace" class="portal-nav">
        {sections.map(([id, label, icon]) => (
          <button
            type="button"
            data-section={id}
            aria-current={id === 'overview' ? 'page' : undefined}
          >
            <span aria-hidden="true">{icon}</span>
            {label}
            {id === 'work' && <small data-active-count>—</small>}
          </button>
        ))}
      </nav>
      <div class="portal-sidebar-bottom">
        <span class="portal-team-icon">M</span>
        <strong>A team behind the numbers.</strong>
        <p>Have a question about your website or the next step?</p>
        <a href="mailto:growwith@markevance.com">Talk to Markevance ↗</a>
      </div>
      <button type="button" class="portal-signout" data-signout>
        ↩ <span>Sign out</span>
      </button>
    </aside>
    <div class="portal-app-content">
      <header class="portal-topbar">
        <p>
          Client workspace <span aria-hidden="true">/</span>{' '}
          <strong data-section-breadcrumb>Overview</strong>
        </p>
        <div class="portal-account">
          <span class="portal-status-dot"></span>
          <span data-account-type>Account access</span>
          <span class="portal-avatar" data-avatar>
            —
          </span>
          <ThemeToggle />
        </div>
      </header>
      <div class="portal-sample-banner" data-sample-banner hidden>
        <span>
          <strong>Sample workspace</strong> · Illustrative figures and example
          work.
        </span>
        <a href="/client-portal/">Back to sign in ↗</a>
      </div>
      <main
        id="portal-main"
        class="portal-dashboard"
        tabindex="-1"
        aria-busy="true"
      >
        <div class="portal-heading">
          <div>
            <p class="portal-kicker">YOUR GROWTH, IN VIEW</p>
            <h1 data-section-title>Your website, in focus.</h1>
            <p class="portal-muted" data-section-intro>
              A shared view of performance, progress and what comes next.
            </p>
          </div>
          <div class="portal-period">
            <label class="sr-only" for="portal-period">
              Reporting period
            </label>
            <select id="portal-period" disabled>
              <option value="7">Last 7 days</option>
              <option value="28" selected>
                Last 28 days
              </option>
              <option value="90">Last 90 days</option>
            </select>
            <span data-date-label>Loading reporting dates</span>
          </div>
        </div>
        <p class="portal-loading" role="status" data-portal-status>
          Loading your workspace…
        </p>
        <div data-portal-content hidden>
          <section
            class="portal-section"
            data-panel="overview performance"
            aria-label="Key website measures"
          >
            <div class="portal-metrics" data-metrics></div>
          </section>
          <div
            class="portal-chart-grid portal-section"
            data-panel="overview performance"
          >
            <section
              class="portal-card traffic-card"
              aria-labelledby="traffic-title"
            >
              <div class="portal-card-heading">
                <div>
                  <p class="portal-card-kicker">AUDIENCE</p>
                  <h2 id="traffic-title">Website activity</h2>
                </div>
                <span class="portal-card-tag">Visits</span>
              </div>
              <div class="portal-chart-summary">
                <strong data-visit-total>—</strong>
                <span data-visit-change></span>
              </div>
              <div class="portal-chart-legend">
                <span>
                  <i class="legend-current"></i>Current period
                </span>
                <span>
                  <i class="legend-previous"></i>Previous period
                </span>
              </div>
              <div class="portal-chart" data-chart></div>
              <div class="portal-chart-inspector">
                <label for="chart-day">Explore a day</label>
                <input
                  id="chart-day"
                  type="range"
                  min="0"
                  max="27"
                  value="27"
                />
                <output for="chart-day" data-day-value></output>
              </div>
            </section>
            <section
              class="portal-card channel-card"
              aria-labelledby="channel-title"
            >
              <div class="portal-card-heading">
                <div>
                  <p class="portal-card-kicker">ACQUISITION</p>
                  <h2 id="channel-title">Where visits come from</h2>
                </div>
              </div>
              <div class="portal-donut" data-donut></div>
              <div class="portal-channel-list" data-channels></div>
              <p class="portal-card-note">
                Channel attribution follows the connected reporting source.
              </p>
            </section>
          </div>
          <section
            class="portal-card portal-section"
            data-panel="overview"
            aria-labelledby="next-step-title"
          >
            <div class="portal-next-step">
              <span class="portal-next-icon" aria-hidden="true">
                ↗
              </span>
              <div>
                <p class="portal-card-kicker">THE NEXT COMMERCIAL STEP</p>
                <h2 id="next-step-title" data-next-title>
                  Connect the work to the next conversation.
                </h2>
                <p class="portal-muted" data-next-copy></p>
              </div>
              <button class="portal-small-button" type="button" data-go-work>
                View work plan →
              </button>
            </div>
          </section>
          <section
            class="portal-card portal-section"
            data-panel="overview work"
            aria-labelledby="work-title"
          >
            <div class="portal-card-heading">
              <div>
                <p class="portal-card-kicker">DELIVERY</p>
                <h2 id="work-title">What’s moving forward</h2>
              </div>
              <label class="portal-filter-label">
                Show{' '}
                <select data-task-filter>
                  <option value="all">All work</option>
                  <option value="active">In progress</option>
                  <option value="complete">Completed</option>
                  <option value="planned">Up next</option>
                </select>
              </label>
            </div>
            <div class="portal-work-summary" data-work-summary></div>
            <div class="portal-task-list" data-tasks></div>
          </section>
          <section
            class="portal-card portal-section"
            data-panel="performance"
            aria-labelledby="daily-title"
          >
            <div class="portal-card-heading">
              <div>
                <p class="portal-card-kicker">THE DETAIL</p>
                <h2 id="daily-title">Daily activity</h2>
              </div>
              <button class="portal-small-button" type="button" data-export>
                Download CSV ↓
              </button>
            </div>
            <div class="portal-table-wrap">
              <table class="portal-table">
                <thead>
                  <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Website visits</th>
                    <th scope="col">Previous period</th>
                    <th scope="col">Change</th>
                  </tr>
                </thead>
                <tbody data-daily-rows></tbody>
              </table>
            </div>
          </section>
          <section
            class="portal-card portal-section"
            data-panel="reports"
            aria-labelledby="report-title"
          >
            <div class="portal-card-heading">
              <div>
                <p class="portal-card-kicker">REPORTING</p>
                <h2 id="report-title">Your performance summary</h2>
              </div>
              <button class="portal-small-button" type="button" data-export>
                Download CSV ↓
              </button>
            </div>
            <p class="portal-muted">
              Export the selected reporting period with daily visits and the
              previous-period comparison.
            </p>
            <div class="portal-report-cover">
              <span class="portal-kicker">MARKEVANCE / WEBSITE REPORT</span>
              <h3 data-report-company>Client website</h3>
              <p data-report-period></p>
              <div data-report-metrics></div>
              <p>
                Figures reflect the available source data. Sales outcomes
                require confirmation from your sales records.
              </p>
            </div>
          </section>
          <section
            class="portal-card portal-section"
            data-panel="workspace"
            aria-labelledby="workspace-title"
          >
            <div class="portal-card-heading">
              <div>
                <p class="portal-card-kicker">ACCOUNT</p>
                <h2 id="workspace-title">Your connected workspace</h2>
              </div>
            </div>
            <dl class="portal-workspace-details">
              <div>
                <dt>Business</dt>
                <dd data-detail-company></dd>
              </div>
              <div>
                <dt>Website</dt>
                <dd data-detail-website></dd>
              </div>
              <div>
                <dt>Reporting updated</dt>
                <dd data-detail-updated></dd>
              </div>
              <div>
                <dt>Account access</dt>
                <dd data-detail-access></dd>
              </div>
            </dl>
            <h3 class="portal-subheading">Data sources</h3>
            <div class="portal-integration-list">
              <div>
                <span class="integration-icon">GA</span>
                <span>
                  <strong>Google Analytics 4</strong>
                  <small>Website visits and acquisition</small>
                </span>
                <span class="portal-source-status">Awaiting connection</span>
              </div>
              <div>
                <span class="integration-icon">SC</span>
                <span>
                  <strong>Google Search Console</strong>
                  <small>Search visibility and clicks</small>
                </span>
                <span class="portal-source-status">Awaiting connection</span>
              </div>
              <div>
                <span class="integration-icon">M</span>
                <span>
                  <strong>Markevance delivery updates</strong>
                  <small>Work plans and progress</small>
                </span>
                <span class="portal-source-status" data-delivery-source>
                  Sample activity
                </span>
              </div>
            </div>
            <p class="portal-card-note">
              Source connections are configured by your Markevance team. Each
              update is published to your business’s workspace.
            </p>
          </section>
          <footer class="portal-dashboard-footer">
            <span data-updated-label></span>
            <span>
              Built around your next step.{' '}
              <a href="mailto:growwith@markevance.com">Talk to your team ↗</a>
            </span>
          </footer>
        </div>
      </main>
    </div>
  </div>
</PortalLayout>
<script>
  import '../../../components/portal/dashboard.ts';
</script>
