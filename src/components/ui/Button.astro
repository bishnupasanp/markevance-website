---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary';
}
const {
  variant = 'primary',
  type = 'button',
  class: className,
  ...attributes
} = Astro.props;
---

<button
  type={type}
  class:list={['button', `button-${variant}`, className]}
  {...attributes}
>
  <slot />
</button>
