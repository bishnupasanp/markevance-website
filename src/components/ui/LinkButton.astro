---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary';
}
const {
  href,
  variant = 'primary',
  class: className,
  ...attributes
} = Astro.props;
---

<a
  href={href}
  class:list={['button', `button-${variant}`, className]}
  {...attributes}
>
  <slot />
</a>
