---
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import { footerNavigation } from '../../data/navigation.ts';
import { siteConfig } from '../../data/site.ts';
---

<footer class="site-footer" data-theme="dark">
  <Container>
    <div class="footer-intro">
      <div>
        <Logo
          theme="dark"
          variant="stacked"
          compactOnMobile={false}
          class="footer-brand"
        />
        <p class="text-text-muted-dark">{siteConfig.positioning}</p>
        <p class="mt-3 text-text-muted-dark">{siteConfig.tagline}</p>
      </div>
      <section class="footer-contact" aria-labelledby="footer-contact-title">
        <h2 id="footer-contact-title">Start a conversation.</h2>
        <a href="mailto:growwith@markevance.com">
          growwith@markevance.com <span aria-hidden="true">↗</span>
        </a>
        <a href="https://wa.me/9779815515225" target="_blank" rel="noreferrer">
          Message on WhatsApp <span aria-hidden="true">↗</span>
        </a>
      </section>
    </div>
    <nav aria-label="Footer" class="footer-grid">
      {footerNavigation.map((group) => (
        <div>
          <h2 class="text-body font-semibold tracking-normal">{group.label}</h2>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <p class="footer-bottom text-small text-text-muted-dark">
      Copyright {new Date().getFullYear()} Markevance. All rights reserved.
    </p>
  </Container>
</footer>
<style>
  .site-footer {
    padding-block: 4rem;
    background: var(--color-background-dark);
    color: var(--color-text-light);
  }
  :global(.footer-brand) {
    --logo-width: 14rem;
    --logo-mobile-width: 14rem;
    --logo-height: 9.1rem;
    --logo-aspect-ratio: 800 / 520;
  }
  .footer-contact {
    display: grid;
    align-content: start;
    gap: 0.25rem;
  }
  .footer-contact h2 {
    font-size: var(--text-h3);
    margin-bottom: 1rem;
  }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    overflow-wrap: anywhere;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--border-dark);
    text-decoration: none;
    color: var(--color-link-dark);
  }
  .footer-contact a:hover {
    color: var(--color-link-dark);
    text-decoration: underline;
  }
  .footer-intro > div > p:first-of-type {
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .footer-intro {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(0, 1fr);
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-dark);
  }
  .footer-intro > div {
    min-width: 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-block: 2.5rem;
  }
  .footer-grid ul {
    list-style: none;
    padding: 0;
    margin-block-start: 0.5rem;
  }
  .footer-grid a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--color-text-muted-dark);
    text-decoration: none;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .footer-grid a:hover {
    color: var(--color-link-dark);
    text-decoration: underline;
  }
  .footer-bottom {
    max-width: none;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-dark);
  }
  .footer-grid > div:last-child {
    grid-column: 1 / -1;
  }
  .footer-grid > div:last-child ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  @media (min-width: 64rem) {
    .footer-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-column);
    }
    .footer-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .footer-grid > div:last-child {
      grid-column: auto;
    }
    .footer-grid > div:last-child ul {
      display: block;
    }
  }
</style>
