---
import Container from '../ui/Container.astro';
import LinkButton from '../ui/LinkButton.astro';
import RelatedLinks from './RelatedLinks.astro';
---

<section
  class="page-band page-band-light"
  aria-labelledby="contact-availability"
>
  <Container>
    <div class="page-split">
      <div>
        <p class="eyebrow">CONTACT MARKEVANCE</p>
        <h2 id="contact-availability">Choose how to reach Markevance.</h2>
      </div>
      <div class="page-copy">
        <p>
          Email or WhatsApp Markevance directly, or send a consultation request
          with a little context about your business and growth priorities.
        </p>
        <div class="contact-actions">
          <a class="text-link" href="mailto:growwith@markevance.com">
            Email Markevance
            <span>growwith@markevance.com</span>
          </a>
          <a
            class="text-link"
            href="https://wa.me/9779815515225"
            target="_blank"
            rel="noreferrer"
          >
            WhatsApp Markevance
            <span>+977 9815515225</span>
          </a>
          <LinkButton href="/book-consultation/">
            Book a Growth Consultation
          </LinkButton>
        </div>
      </div>
    </div>
    <div class="system-connection">
      <h3>Context for a useful first conversation</h3>
      <ul class="measure-list">
        <li>Your product, programme or service and its current customers.</li>
        <li>The buyer or audience you want to reach.</li>
        <li>How enquiries arrive and who follows up.</li>
        <li>
          The main acquisition bottleneck and your next commercial objective.
        </li>
      </ul>
    </div>
    <RelatedLinks
      links={[
        { label: 'Solutions', href: '/services/' },
        {
          label: 'Technology & Software',
          href: '/industries/technology-software/',
        },
        { label: 'Education', href: '/industries/education/' },
        { label: 'How We Work', href: '/how-we-work/' },
      ]}
    />
  </Container>
</section>
<style>
  .contact-actions {
    display: grid;
    justify-items: start;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .contact-actions .text-link span {
    display: block;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }
</style>
