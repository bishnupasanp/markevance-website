---
import Container from '../ui/Container.astro';
import RelatedLinks from './RelatedLinks.astro';
import type { LegalDefinition } from '../../types/public-pages.ts';
import type { PageLink } from '../../types/public-pages.ts';
interface Props {
  page: LegalDefinition;
}
const { page } = Astro.props;
const related: readonly PageLink[] = [
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Terms', href: '/terms/' },
  { label: 'Cookie Policy', href: '/cookie-policy/' },
  { label: 'Contact', href: '/contact/' },
];
---

<section class="page-band page-band-light" aria-label={page.title}>
  <Container>
    {page.reviewPending && (
      <p class="legal-review-status">
        <strong>Draft policy · awaiting final review.</strong>
        For questions,{' '}
        <a class="text-link" href="/contact/">
          contact Markevance
        </a>
        .
      </p>
    )}
    <div class="legal-layout">
      <nav class="legal-contents" aria-label="On this page">
        <p class="eyebrow">ON THIS PAGE</p>
        <ol>
          {page.sections.map((section) => (
            <li>
              <a class="text-link" href={`#${section.id}`}>
                {section.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <article class="legal-copy">
        {page.sections.map((section) => (
          <section id={section.id} aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))}
      </article>
    </div>
    <RelatedLinks links={related.filter((link) => link.href !== page.path)} />
  </Container>
</section>
