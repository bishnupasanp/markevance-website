---
import Container from '../ui/Container.astro';
import PageCTA from './PageCTA.astro';
import RelatedLinks from './RelatedLinks.astro';
import { services } from '../../data/services.ts';
import { industries } from '../../data/industries.ts';
interface Props {
  kind: 'services' | 'industries';
}
const { kind } = Astro.props;
const models = [
  {
    name: 'Growth Foundation',
    copy: 'For a business that needs a clear starting point.',
    scope:
      'Discovery, customer research, funnel and tracking review, lead-flow mapping and a prioritised growth roadmap.',
  },
  {
    name: 'Lead Generation Engine',
    copy: 'For a business ready to build relevant inbound demand.',
    scope:
      'Selected campaigns, landing pages, lead capture, conversion review and reporting connected to enquiry quality.',
  },
  {
    name: 'B2B Pipeline Engine',
    copy: 'For technology businesses that need marketing and outbound sales development.',
    scope:
      'Demand generation, prospect research, outreach, qualification, follow-up and meeting handoffs to the client’s sales team.',
  },
];
---

{kind === 'services' ? (
  <>
    <section
      class="page-band"
      data-theme="dark"
      aria-labelledby="capability-directory"
    >
      <Container>
        <div class="page-split">
          <div>
            <p class="eyebrow">CONNECTED CAPABILITIES</p>
            <h2 id="capability-directory">
              Choose the work that addresses the bottleneck.
            </h2>
          </div>
          <div class="page-copy">
            <p>
              These capabilities support the three core engagement models. They
              are not five disconnected packages or a requirement to buy every
              channel.
            </p>
            <p>
              Discovery determines the priorities, the operating
              responsibilities and what can realistically be measured.
            </p>
          </div>
        </div>
        <ol class="directory-list">
          {services.map((service, index) => (
            <li>
              <div class="directory-heading">
                <span class="list-index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3>{service.name}</h3>
              </div>
              <div>
                <p>{service.intro}</p>
                <a class="text-link" href={service.path}>
                  Explore {service.name}
                  <span aria-hidden="true"> ↗</span>
                </a>
              </div>
            </li>
          ))}
        </ol>
      </Container>
    </section>
    <section
      class="page-band page-band-light"
      aria-labelledby="engagement-directory"
    >
      <Container>
        <div class="page-split">
          <div>
            <p class="eyebrow">THREE ENGAGEMENT MODELS</p>
            <h2 id="engagement-directory">Start at the right level.</h2>
          </div>
          <div class="page-copy">
            <p>
              Scope follows the business situation, channel readiness and
              available sales capacity. Advertising spend is separate from
              agency fees; pricing is discussed after the work is understood.
            </p>
          </div>
        </div>
        <dl class="model-register">
          {models.map((model) => (
            <div>
              <dt>{model.name}</dt>
              <dd>
                <p>{model.copy}</p>
                <p>{model.scope}</p>
              </dd>
            </div>
          ))}
        </dl>
        <RelatedLinks
          links={[
            {
              label: 'Technology & Software',
              href: '/industries/technology-software/',
            },
            { label: 'Education', href: '/industries/education/' },
            { label: 'How We Work', href: '/how-we-work/' },
          ]}
        />
      </Container>
    </section>
  </>
) : (
  <>
    <section
      class="page-band"
      data-theme="dark"
      aria-labelledby="industry-directory"
    >
      <Container>
        <div class="page-split">
          <div>
            <p class="eyebrow">PRIMARY FOCUS</p>
            <h2 id="industry-directory">
              Two buying journeys. One connected discipline.
            </h2>
          </div>
          <div class="page-copy">
            <p>
              Our primary focus is established technology/software and education
              businesses in Nepal. We shape the work around the audience, the
              offer and the team that owns the next step.
            </p>
          </div>
        </div>
        <ol class="directory-list">
          {industries.map((industry, index) => (
            <li>
              <div class="directory-heading">
                <span class="list-index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3>{industry.name}</h3>
              </div>
              <div>
                <p>{industry.intro}</p>
                <a class="text-link" href={industry.path}>
                  Explore {industry.name}
                  <span aria-hidden="true"> ↗</span>
                </a>
              </div>
            </li>
          ))}
        </ol>
      </Container>
    </section>
    <section class="page-band page-band-light" aria-labelledby="industry-fit">
      <Container>
        <div class="page-split">
          <div>
            <p class="eyebrow">ENGAGEMENT FIT</p>
            <h2 id="industry-fit">Growth needs something worth growing.</h2>
          </div>
          <div class="page-copy">
            <p>
              A working product or programme, existing customers, capacity to
              serve more demand and a team available to follow up are useful
              starting conditions.
            </p>
            <p>
              For technology clients, demos and closing remain client
              responsibilities. For education providers, programme accuracy,
              counselling and admissions remain with the institution.
            </p>
          </div>
        </div>
        <div class="secondary-notes">
          <h3>Selective secondary capabilities</h3>
          <p class="section-context">
            These sectors are considered where the offer, operating capacity and
            acquisition model fit. The commercial objective and follow-up
            capacity determine whether the work is a good fit.
          </p>
          <dl>
            <div>
              <dt>Healthcare</dt>
              <dd>
                Relevant enquiries and appointment journeys, with appropriate
                privacy and claims review.
              </dd>
            </div>
            <div>
              <dt>Real Estate</dt>
              <dd>
                Qualified property enquiries and site-visit follow-up based on
                verified project information.
              </dd>
            </div>
            <div>
              <dt>Selected E-commerce</dt>
              <dd>
                Customer acquisition for proven products with sustainable
                margins, inventory and fulfilment capacity.
              </dd>
            </div>
          </dl>
        </div>
        <RelatedLinks
          links={[
            { label: 'Connected solutions', href: '/services/' },
            { label: 'How We Work', href: '/how-we-work/' },
          ]}
        />
      </Container>
    </section>
  </>
)}
<PageCTA />
