---
interface Props {
  class?: string;
  vertical?: boolean;
}
const { class: className, vertical = false } = Astro.props;
---

<svg
  class:list={['forward-line', className]}
  aria-hidden="true"
  viewBox={vertical ? '0 0 2 100' : '0 0 100 2'}
  preserveAspectRatio="none"
>
  <path
    class="forward-line-base"
    d={vertical ? 'M1 0V100' : 'M0 1H100'}
    pathLength="1"
  />
  <path
    class="forward-line-active"
    data-forward-path
    d={vertical ? 'M1 0V100' : 'M0 1H100'}
    pathLength="1"
  />
</svg>
