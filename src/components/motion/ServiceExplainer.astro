---
import type { ServiceDefinition } from '../../types/public-pages.ts';
interface Props {
  service: ServiceDefinition;
}
const { service } = Astro.props;
---

<div class="service-explainer" id="service-explainer" data-service-explainer>
  <p class="explainer-instruction">Explore the work, one step at a time.</p>
  <ol
    class="explainer-stages"
    aria-label={`${service.name} work stages`}
    data-service-tabs
  >
    {service.work.map((step, index) => (
      <li>
        <a
          href={`#service-work-${index + 1}`}
          id={`service-work-tab-${index + 1}`}
          data-service-tab
        >
          <span class="explainer-number" aria-hidden="true">
            0{index + 1}
          </span>
          <span class="explainer-node" aria-hidden="true"></span>
          <span>{step.title}</span>
        </a>
      </li>
    ))}
  </ol>
  <div class="explainer-panels">
    {service.work.map((step, index) => (
      <section
        class="explainer-panel"
        id={`service-work-${index + 1}`}
        aria-labelledby={`service-work-heading-${index + 1}`}
        data-service-panel
      >
        <p class="explainer-step">
          {service.name} <span aria-hidden="true">/</span> Step 0{index + 1}
        </p>
        <h3 id={`service-work-heading-${index + 1}`}>{step.title}</h3>
        <p>{step.copy}</p>
      </section>
    ))}
  </div>
  <p class="explainer-caption">
    Illustrative service sequence. Scope and responsibilities are agreed for
    each engagement.
  </p>
</div>

<script>
  import { initializeServiceExplainers } from './service-explainer.ts';
  initializeServiceExplainers();
</script>

<style>
  .service-explainer {
    margin-top: 2.5rem;
    --service-progress: 0;
  }
  .explainer-instruction,
  .explainer-caption,
  .explainer-step {
    color: var(--color-text-muted-dark);
    font-size: var(--text-small);
  }
  .explainer-stages {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
    margin-block: 1.5rem 2rem;
  }
  .explainer-stages a {
    display: grid;
    grid-template-columns: 1.5rem 0.75rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text-light);
    min-height: var(--touch-target);
    font-weight: 500;
  }
  .explainer-stages a:hover,
  .explainer-stages [aria-selected='true'] {
    color: var(--color-link-dark);
  }
  .explainer-number {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 400;
    color: var(--color-text-muted-dark);
  }
  .explainer-node {
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid var(--color-text-muted-dark);
    background: var(--color-background-dark);
    border-radius: 50%;
    transition: background-color var(--duration-standard) var(--ease-standard);
  }
  [data-complete] .explainer-node {
    background: var(--color-brand);
    border-color: var(--color-link-dark);
  }
  [aria-selected='true'] .explainer-node {
    background: var(--color-accent-prestige);
    border-color: var(--color-accent-prestige);
    border-radius: 0;
  }
  .explainer-panel {
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .explainer-panel h3 {
    font-size: var(--text-h2);
    max-width: 24ch;
    margin-block: 0.75rem 1rem;
  }
  .explainer-panel > p:last-child {
    color: var(--color-text-muted-dark);
    max-width: 62ch;
    font-size: var(--text-body-large);
  }
  .explainer-caption {
    margin-top: 1.5rem;
  }
  /* Overlapping grid cells reserve the tallest panel without measuring or shifting layout. */
  [data-enhanced] .explainer-panels {
    display: grid;
  }
  [data-enhanced] .explainer-panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transform: translateY(0.5rem);
    pointer-events: none;
    transition:
      opacity var(--duration-standard) var(--ease-standard),
      transform var(--duration-standard) var(--ease-standard);
  }
  [data-enhanced] .explainer-panel[data-active] {
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  @media (min-width: 48rem) {
    .explainer-stages {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      position: relative;
    }
    .explainer-stages::before,
    .explainer-stages::after {
      content: '';
      position: absolute;
      top: 2.75rem;
      left: 0.375rem;
      right: 0.375rem;
      height: 2px;
      background: var(--color-border);
      pointer-events: none;
    }
    .explainer-stages::after {
      background: var(--color-brand);
      transform: scaleX(var(--service-progress));
      transform-origin: left;
      transition: transform var(--duration-standard) var(--ease-standard);
    }
    .explainer-stages a {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      border: 0;
      padding-top: 0;
    }
    .explainer-node {
      outline: 5px solid var(--color-background-dark);
    }
    .explainer-stages a > span:last-child {
      padding-right: 1rem;
    }
    .explainer-panel {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-column);
      align-content: start;
    }
    .explainer-step {
      grid-column: 1 / -1;
      margin-bottom: 1rem;
    }
    .explainer-panel h3 {
      margin: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .explainer-panel,
    .explainer-node,
    .explainer-stages::after {
      transition: none !important;
      transform: none;
    }
    .explainer-stages::after {
      transform: scaleX(var(--service-progress));
    }
  }
</style>
