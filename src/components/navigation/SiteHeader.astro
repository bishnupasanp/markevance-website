---
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import PrimaryNavigation from './PrimaryNavigation.astro';
---

<header class="site-header" data-theme="dark" data-site-header>
  <Container class="header-inner">
    <Logo theme="dark" responsiveWordmark />
    <details class="mobile-menu" data-mobile-menu>
      <summary
        class="menu-toggle"
        aria-controls="mobile-primary-navigation"
        data-menu-toggle
      >
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <span>Menu</span>
      </summary>
      <PrimaryNavigation mobile />
    </details>
    <PrimaryNavigation />
  </Container>
</header>
<script>
  import { initializeMenu } from './menu.ts';
  initializeMenu();
</script>
<style>
  .site-header {
    position: relative;
    background: var(--color-background-dark);
    color: var(--color-text-light);
    border-bottom: 1px solid var(--border-dark);
    container-type: inline-size;
  }
  :global(.header-inner) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    padding-block: calc((var(--header-mobile-height) - var(--logo-height)) / 2);
    min-height: var(--header-mobile-height);
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--touch-target);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-text-muted-dark);
    border-radius: var(--radius-control);
    cursor: pointer;
    list-style: none;
    font-size: var(--text-small);
  }
  .menu-toggle::marker {
    content: '';
  }
  .menu-toggle::-webkit-details-marker {
    display: none;
  }
  /* Let enlarged text create two rows instead of colliding with the wordmark. */
  @container (max-width: 12rem) {
    :global(.header-inner) {
      grid-template-columns: minmax(0, 1fr);
    }
    .mobile-menu {
      justify-self: end;
      max-width: 100%;
    }
  }
  @media (min-width: 80rem) {
    :global(.header-inner) {
      display: grid;
      grid-template-rows: auto;
      grid-template-columns: var(--logo-width) minmax(0, 1fr);
      column-gap: 2rem;
      padding-block: calc((var(--header-height) - var(--logo-height)) / 2);
    }
    .mobile-menu {
      display: none;
    }
  }
</style>
