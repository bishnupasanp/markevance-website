---
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { homeCopy as copy } from '../../data/home.ts';
---

<section
  class="home-section fractional-section"
  data-theme="dark"
  aria-labelledby="fractional-title"
>
  <Container class="fractional-layout">
    <div>
      <p class="eyebrow">{copy.fractional.eyebrow}</p>
      <h2 id="fractional-title">{copy.fractional.title}</h2>
    </div>
    <div class="fractional-copy">
      {copy.fractional.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </Container>
</section>
<section class="home-section process-section" aria-labelledby="process-title">
  <Container>
    <p class="eyebrow">{copy.process.eyebrow}</p>
    <div class="editorial-heading">
      <h2 id="process-title">{copy.process.title}</h2>
      <div class="copy-flow">
        {copy.process.intro.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
    <ol class="process-sequence">
      {copy.process.items.map((item, i) => (
        <li>
          <span class="list-index" aria-hidden="true">
            0{i + 1}
          </span>
          <div>
            <h3>{item.title.split(' — ')[1]}</h3>
            <p>{i === 5 ? item.paragraphs.join(' ') : item.paragraphs[0]}</p>
          </div>
        </li>
      ))}
    </ol>
    <a class="home-text-link" href="/how-we-work/">
      {copy.process.cta}
      <Icon name="arrow-up-right" />
    </a>
  </Container>
</section>
