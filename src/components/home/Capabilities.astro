---
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { homeCopy as copy } from '../../data/home.ts';
---

<section
  class="home-section capabilities-section"
  aria-labelledby="capabilities-title"
>
  <Container>
    <p class="eyebrow">{copy.capabilities.eyebrow}</p>
    <div class="editorial-heading">
      <h2 id="capabilities-title">{copy.capabilities.title}</h2>
      <div class="copy-flow">
        {copy.capabilities.intro.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
    <div class="capability-stack">
      {copy.capabilities.items.map((item, i) => (
        <article class="capability-layer">
          <div class="capability-title">
            <span class="list-index" aria-hidden="true">
              0{i + 1}
            </span>
            <h3>{item.title}</h3>
          </div>
          <div>
            <p>{item.copy}</p>
            <a class="home-text-link" href={item.href}>
              {item.cta}
              <Icon name="arrow-up-right" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>
