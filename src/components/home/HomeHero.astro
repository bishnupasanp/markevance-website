---
import Container from '../ui/Container.astro';
import LinkButton from '../ui/LinkButton.astro';
import Icon from '../ui/Icon.astro';
import ServiceHub from './ServiceHub.astro';
import { homeCopy as copy } from '../../data/home.ts';
import { pipelineStages } from '../../data/pipeline.ts';
---

<section class="home-hero" data-theme="dark" aria-labelledby="hero-title">
  <Container>
    <div class="hero-composition">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="hero-eyebrow-rule" aria-hidden="true"></span>
          {copy.hero.eyebrow}
        </p>
        <h1 id="hero-title">
          Turn marketing into <span>qualified pipeline.</span>
        </h1>
        <p class="hero-description">
          Growth marketing and sales development for technology, software and
          education businesses in Nepal.
        </p>
        <div class="home-actions">
          <LinkButton href="/book-consultation/">
            {copy.hero.primary}
            <Icon />
          </LinkButton>
          <a class="hero-secondary" href="#solutions">
            Explore solutions <Icon name="arrow-down" />
          </a>
        </div>
        <p class="hero-market">
          <span aria-hidden="true">↗</span> NEPAL-FIRST. BUSINESS-FOCUSED.
        </p>
      </div>
      <ServiceHub />
    </div>
    <div class="hero-foundation" id="commercial-journey">
      <div class="hero-stage-anchors" aria-hidden="true">
        {pipelineStages.map((stage) => (
          <span id={`pipeline-${stage.slug}`}></span>
        ))}
      </div>
      <span>ONE CONNECTED GROWTH SYSTEM</span>
      <p id="growth-system">
        Create demand. <span aria-hidden="true">↗</span> Build pipeline.{' '}
        <span aria-hidden="true">↗</span> Advance growth.
      </p>
      <a href="/how-we-work/#growth-system">
        See how it connects <Icon name="arrow-up-right" />
      </a>
    </div>
  </Container>
</section>
