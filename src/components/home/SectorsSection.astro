---
// Preserved alternative sector draft. Not wired into the approved homepage.
---

<section
  id="sectors"
  class="w-full bg-background-dark text-text-light py-20 px-4 sm:px-6 lg:px-8 border-b border-border"
>
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 pb-6 border-b border-border">
      <div>
        <div class="text-xs font-mono text-link-dark tracking-widest uppercase mb-2">
          Primary Sectors
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-light">
          Tailored to How Your Buyers Make Decisions
        </h2>
      </div>
      <p class="mt-2 sm:mt-0 text-xs font-mono text-text-muted-dark">
        FOCUSED EXPERTISE / NEPAL & REGIONAL
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Sector 1: Technology & Software -->
      <div class="p-8 bg-surface-dark border border-border relative">
        <div class="text-xs font-mono text-link-dark uppercase tracking-wider mb-2">
          Primary Sector 01
        </div>
        <h3 class="text-xl font-bold text-text-light mb-3">
          Technology, SaaS & Software Companies
        </h3>
        <p class="text-sm text-text-muted-dark mb-6 leading-relaxed">
          Designed for B2B tech companies with validated products seeking to
          move beyond founder-led sales and uncoordinated inbound campaigns.
        </p>
        <div class="space-y-3 text-xs font-mono text-text-light border-t border-border/60 pt-6">
          <div class="flex items-start space-x-2">
            <span class="text-link-dark font-bold">→</span>
            <span>
              <strong>Target Buyers:</strong> Founders, CTOs, Commercial
              Directors, Heads of Growth
            </span>
          </div>
          <div class="flex items-start space-x-2">
            <span class="text-link-dark font-bold">→</span>
            <span>
              <strong>Primary Deliverable:</strong> Sales-accepted discovery
              meetings & product demos
            </span>
          </div>
          <div class="flex items-start space-x-2">
            <span class="text-link-dark font-bold">→</span>
            <span>
              <strong>Funnel Logic:</strong> Problem-Aware Search + High-Intent
              Outbound SDRs
            </span>
          </div>
        </div>
      </div>

      <!-- Sector 2: Higher Education & Training -->
      <div class="p-8 bg-surface-dark border border-border relative">
        <div class="text-xs font-mono text-accent-prestige uppercase tracking-wider mb-2">
          Primary Sector 02
        </div>
        <h3 class="text-xl font-bold text-text-light mb-3">
          Higher Education, Colleges & EdTech
        </h3>
        <p class="text-sm text-text-muted-dark mb-6 leading-relaxed">
          Engineered for academic institutions and professional training
          academies that need qualified student enrollments rather than empty
          social media impressions.
        </p>
        <div class="space-y-3 text-xs font-mono text-text-light border-t border-border/60 pt-6">
          <div class="flex items-start space-x-2">
            <span class="text-accent-prestige font-bold">→</span>
            <span>
              <strong>Target Buyers:</strong> Campus Directors, Admissions
              Committees, Principals
            </span>
          </div>
          <div class="flex items-start space-x-2">
            <span class="text-accent-prestige font-bold">→</span>
            <span>
              <strong>Primary Deliverable:</strong> Pre-screened student
              enquiries & counseling sessions
            </span>
          </div>
          <div class="flex items-start space-x-2">
            <span class="text-accent-prestige font-bold">→</span>
            <span>
              <strong>Funnel Logic:</strong> Search Visibility → Counselling
              Booking → Application
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-border/40 text-xs font-mono text-text-muted-dark flex flex-col sm:flex-row justify-between items-center gap-2">
      <span>
        Selective secondary sectors: Healthcare, Real Estate, and Select
        E-Commerce
      </span>
      <span class="text-accent-prestige">
        High-Ticket / High-LTV Engagements Only
      </span>
    </div>
  </div>
</section>
